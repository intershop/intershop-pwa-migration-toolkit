          "files": "**/.eslintrc.json,**/eslint.config.{mjs,js,cjs}",
          "severity": "high",
          "autoFixable": false,
          "migration": "npm uninstall eslint-plugin-rxjs && npm install @smarttools/eslint-plugin-rxjs",
          "example": {
            "before": "plugins: ['rxjs']  // uses eslint-plugin-rxjs",
