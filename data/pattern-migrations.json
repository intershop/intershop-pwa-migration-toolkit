{
  "version": "1.1.0",
  "lastUpdated": "2026-03-26",
  "description": "Comprehensive pattern migration database for Intershop PWA versions",
  "migrations": [
    {
      "fromVersion": "8.0",
      "toVersion": "9.0",
      "description": "PWA 8.x → 9.0 Breaking Changes",
      "patterns": [
        {
          "type": "scss",
          "description": "SCSS: Sass module system - darken() deprecated",
          "oldPattern": "darken\\s*\\(",
          "newPattern": "color.adjust($color, $lightness: -X%)",
          "searchRegex": "darken\\s*\\(",
          "files": "**/*.scss",
          "severity": "high",
          "requiresImport": "@use 'sass:color';",
          "example": {
            "before": "$dark-color: darken($primary, 20%);",
            "after": "$dark-color: color.adjust($primary, $lightness: -20%);"
          }
        },
        {
          "type": "scss",
          "description": "SCSS: Sass module system - lighten() deprecated",
          "oldPattern": "lighten\\s*\\(",
          "newPattern": "color.adjust($color, $lightness: X%)",
          "searchRegex": "lighten\\s*\\(",
          "files": "**/*.scss",
          "severity": "high",
          "requiresImport": "@use 'sass:color';",
          "example": {
            "before": "$light-color: lighten($primary, 20%);",
            "after": "$light-color: color.adjust($primary, $lightness: 20%);"
          }
        },
        {
          "type": "scss",
          "description": "SCSS: Sass module system - map-get() deprecated",
          "oldPattern": "map-get\\s*\\(",
          "newPattern": "map.get(",
          "searchRegex": "map-get\\s*\\(",
          "files": "**/*.scss",
          "severity": "medium",
          "requiresImport": "@use 'sass:map';",
          "example": {
            "before": "$value: map-get($theme-colors, 'primary');",
            "after": "$value: map.get($theme-colors, 'primary');"
          }
        },
        {
          "type": "scss",
          "description": "SCSS: Sass module system - map-merge() deprecated",
          "oldPattern": "map-merge\\s*\\(",
          "newPattern": "map.merge(",
          "searchRegex": "map-merge\\s*\\(",
          "files": "**/*.scss",
          "severity": "medium",
          "requiresImport": "@use 'sass:map';",
          "example": {
            "before": "$merged: map-merge($defaults, $custom);",
            "after": "$merged: map.merge($defaults, $custom);"
          }
        },
        {
          "type": "scss",
          "description": "SCSS: Sass module system - str-length() deprecated",
          "oldPattern": "str-length\\s*\\(",
          "newPattern": "string.length(",
          "searchRegex": "str-length\\s*\\(",
          "files": "**/*.scss",
          "severity": "low",
          "requiresImport": "@use 'sass:string';",
          "example": {
            "before": "$len: str-length($text);",
            "after": "$len: string.length($text);"
          }
        }
      ]
    },
    {
      "fromVersion": "9.0",
      "toVersion": "9.1",
      "description": "PWA 9.0 → 9.1 Breaking Changes",
      "patterns": [
        {
          "type": "typescript",
          "description": "TypeScript: Stricter environment.model.ts typing",
          "searchRegex": "export\\s+const\\s+environment\\s*=",
          "files": "**/environment.model.ts",
          "severity": "medium",
          "manual": true,
          "example": {
            "before": "export const environment = { features: ['customFeature'] };",
            "after": "export const environment: Environment = { features: ['customFeature' as const] };"
          }
        },
        {
          "type": "html",
          "description": "Angular Templates: Empty paired tags should use self-closing syntax",
          "searchRegex": "<(ish-[a-z-]+|ng-container|ng-template)([^>]*)></\\1>",
          "files": "**/*.html",
          "severity": "low",
          "autoFixable": true,
          "example": {
            "before": "<ish-loading></ish-loading>",
            "after": "<ish-loading />"
          }
        }
      ]
    },
    {
      "fromVersion": "9.1",
      "toVersion": "10.0",
      "description": "PWA 9.1 → 10.0 Major Release - Angular 17, Bootstrap Icons, SCSS Cleanup",
      "releaseDate": "2026-03-13",
      "angularVersion": "17",
      "nodeVersion": "22.22.0",
      "npmVersion": "10.9.4",
      "icmRequirements": {
        "minimum": "11.0.0",
        "recommended": "14.1.0",
        "notes": "Some features require ICM 11+; Recurring orders with warranties require ICM 14.1.0 + Recurring Order Extension 2.3.0",
        "features": [
          {
            "feature": "Product Inventory Separate Fetch",
            "icmMinVersion": "11.0.0",
            "restApi": "/inventories endpoint",
            "description": "Product inventory data fetched separately for better caching"
          },
          {
            "feature": "SPARQUE API v4",
            "icmMinVersion": "11.0.0",
            "description": "SPARQUE services use API version 4 for all REST calls"
          }
        ]
      },
      "scssChanges": {
        "variableRenames": [
          {"old": "$color-corporate", "new": "$bg-color-corporate", "usage": "Corporate color for backgrounds", "severity": "breaking"},
          {"old": "$color-special-primary", "new": "$color-special-error", "usage": "Error state color", "severity": "breaking"},
          {"old": "$color-special-secondary", "new": "$color-special-warning", "usage": "Warning state color", "severity": "breaking"},
          {"old": "$color-special-tertiary", "new": "$color-special-info", "usage": "Info state color", "severity": "breaking"},
          {"old": "$color-special-quaternary", "new": "$color-special-success", "usage": "Success state color", "severity": "breaking"},
          {"old": "$color-label-sale", "new": "$color-special-sale", "usage": "Sale label color", "severity": "breaking"},
          {"old": "$color-label-topseller", "new": "$color-special-topseller", "usage": "Top Seller label color", "severity": "breaking"},
          {"old": "$color-label-new", "new": "$color-special-new", "usage": "New product label color", "severity": "breaking"},
          {"old": "$success-color", "new": "$color-special-success", "usage": "Success state color", "severity": "breaking"},
          {"old": "$error-color", "new": "$color-special-error", "usage": "Error state color", "severity": "breaking"},
          {"old": "$gray-400", "new": "$gray-500", "usage": "Part of new sorted gray color scale", "severity": "breaking"}
        ],
        "variablesRemoved": [
          {"name": "$input-accent-color", "replacement": "$CORPORATE-DARK", "reasoning": "Consolidated color system"},
          {"name": "$button-primary-bg", "replacement": "$CORPORATE-PRIMARY", "reasoning": "Simplified button theming"},
          {"name": "$button-primary-border", "replacement": "$CORPORATE-PRIMARY", "reasoning": "Simplified button theming"},
          {"name": "$button-default-color", "replacement": "$CORPORATE-PRIMARY", "reasoning": "Simplified button theming"},
          {"name": "$button-default-bg", "replacement": "$color-inverse", "reasoning": "Simplified button theming"},
          {"name": "$button-default-border", "replacement": "$CORPORATE-PRIMARY", "reasoning": "Simplified button theming"},
          {"name": "$button-focus-box-shadow", "replacement": "$CORPORATE-SHADOW", "reasoning": "Consolidated shadow system"},
          {"name": "$datepicker-border-radius", "replacement": "removed", "reasoning": "Using Bootstrap defaults"},
          {"name": "$datepicker-today-bg", "replacement": "removed", "reasoning": "Using Bootstrap defaults"},
          {"name": "$datepicker-today-hover", "replacement": "removed", "reasoning": "Using Bootstrap defaults"},
          {"name": "$datepicker-active-bg", "replacement": "removed", "reasoning": "Using Bootstrap defaults"},
          {"name": "$datepicker-active-hover", "replacement": "removed", "reasoning": "Using Bootstrap defaults"}
        ],
        "colorFunctionNotation": {
          "old": "rgba(0, 0, 0, 0.125)",
          "new": "rgb(0 0 0 / 0.125)",
          "note": "Stylelint rule color-function-notation changed to 'modern' format"
        }
      },
      "apiChanges": [
        {
          "type": "removed",
          "class": "ApiService",
          "method": "options()",
          "replacement": "Use get() method with REST calls of latest REST interface",
          "severity": "breaking",
          "searchRegex": "\\.options\\s*\\(",
          "migration": "Replace apiService.options() calls with apiService.get()"
        },
        {
          "type": "changed",
          "action": "logoutUserSuccess",
          "description": "Now API-specific, only dispatch after successful token revocation",
          "replacement": "Use resetUserData action for non-API logouts (forced logout, session cleanup)",
          "severity": "breaking",
          "files": "**/user.effects.ts,**/identity-provider*.ts"
        },
        {
          "type": "changed",
          "class": "ProductService / ProductFacade",
          "property": "product.inStock / product.availableStock",
          "status": "deprecated",
          "replacement": "Use ShoppingFacade.productInventory$(sku) or ProductContextFacade selectors",
          "willBeRemovedIn": "11.0.0",
          "migration": "Replace direct property access with facade methods",
          "files": "**/*.component.ts"
        }
      ],
      "componentChanges": [
        {
          "component": "LanguageSwitchComponent",
          "change": "Moved from mobile user menu to main header navigation",
          "removed": ["accordion view", "component input variable for accordion"],
          "reason": "Better accessibility and UX",
          "impactedFiles": ["header*.component.html", "mobile-menu*.html"]
        },
        {
          "component": "PaypalComponent",
          "change": "Complete revision of PayPal integration",
          "removed": ["payment-paypal-messages.component.ts"],
          "merged": "All PayPal functionality now in single payment-paypal.component.ts",
          "moved": "PaypalConfigService to src/app/core/utils/paypal/paypal-config",
          "severity": "high"
        }
      ],
      "patterns": [
        {
          "type": "html",
          "description": "Angular 17: Control flow - *ngIf to @if migration",
          "searchRegex": "\\*ngIf\\s*=",
          "files": "**/*.html",
          "severity": "critical",
          "autoFixable": false,
          "manual": true,
          "schematic": "ng generate @angular/core:control-flow",
          "note": "Use Angular CLI schematic or migrate-control-flow.js script",
          "example": {
            "before": "<div *ngIf=\"show\">Content</div>",
            "after": "@if (show) { <div>Content</div> }"
          }
        },
        {
          "type": "html",
          "description": "Angular 17: Control flow - *ngFor to @for migration (track required)",
          "searchRegex": "\\*ngFor\\s*=",
          "files": "**/*.html",
          "severity": "critical",
          "autoFixable": false,
          "manual": true,
          "schematic": "ng generate @angular/core:control-flow",
          "note": "track expression is mandatory. Use unique identifier or full object for nested loops",
          "example": {
            "before": "<div *ngFor=\"let item of items\">{{item}}</div>",
            "after": "@for (item of items; track item.id) { <div>{{item}}</div> }",
            "complexCase": "@for (item of items; track item) { /* use object when unique id unavailable */ }"
          }
        },
        {
          "type": "html",
          "description": "Angular 17: Control flow - *ngSwitch to @switch migration",
          "searchRegex": "\\*ngSwitch\\s*=",
          "files": "**/*.html",
          "severity": "critical",
          "autoFixable": false,
          "manual": true,
          "schematic": "ng generate @angular/core:control-flow",
          "example": {
            "before": "<div [ngSwitch]=\"value\">\n  <span *ngSwitchCase=\"'a'\">A</span>\n  <span *ngSwitchDefault>Other</span>\n</div>",
            "after": "@switch (value) {\n  @case ('a') { <span>A</span> }\n  @default { <span>Other</span> }\n}"
          }
        },
        {
          "type": "scss",
          "description": "Icons: Font Awesome replaced with Bootstrap Icons (22% bundle size reduction)",
          "searchRegex": "(fa-|fas\\s|far\\s|fab\\s|font-awesome|<fa-icon)",
          "files": "**/*.{scss,html,ts}",
          "severity": "high",
          "manual": true,
          "script": "scripts/migrate-bootstrap-icons.js",
          "note": "Use migrate-bootstrap-icons.js for detection and auto-replacement of common icons",
          "removed": "src/app/core/icon.module.ts",
          "styling": "Icon size determined by font-size (inherited from parent)",
          "example": {
            "before": "<fa-icon [icon]=\"['fas', 'print']\" />",
            "after": "<i class=\"bi bi-printer-fill\"></i>"
          },
          "commonMappings": [
            {"fontAwesome": "fa-search", "bootstrapIcons": "bi-search"},
            {"fontAwesome": "fa-times / fa-close", "bootstrapIcons": "bi-x"},
            {"fontAwesome": "fa-shopping-cart", "bootstrapIcons": "bi-cart"},
            {"fontAwesome": "fa-cog / fa-settings", "bootstrapIcons": "bi-gear"},
            {"fontAwesome": "fa-user", "bootstrapIcons": "bi-person"},
            {"fontAwesome": "fa-home", "bootstrapIcons": "bi-house"},
            {"fontAwesome": "fa-print", "bootstrapIcons": "bi-printer-fill"}
          ]
        },
        {
          "type": "scss",
          "description": "SCSS: Variable renames - Color system cleanup",
          "searchRegex": "\\$color-corporate|\\$color-special-primary|\\$success-color|\\$error-color",
          "files": "src/styles/**/*.scss",
          "severity": "critical",
          "manual": true,
          "script": "scripts/validate-theme-completeness.js",
          "note": "Run validate-theme-completeness.js to detect missing variables, then sync-custom-theme-variables.js to add them",
          "documentation": "See scssChanges.variableRenames for complete mapping"
        },
        {
          "type": "typescript",
          "description": "Inventory: Separate /inventories REST call for better caching",
          "searchRegex": "product\\.inStock|product\\.availableStock",
          "files": "**/*.{ts,component.ts}",
          "severity": "medium",
          "manual": true,
          "deprecation": "product.inStock and product.availableStock deprecated, will be removed in 11.0",
          "migration": "Replace with ShoppingFacade.productInventory$(sku) or ProductContextFacade.select('inventory', 'inStock')",
          "example": {
            "before": "if (product.inStock) { ... }",
            "after": "this.productContext.select('inventory', 'inStock').subscribe(inStock => { ... })"
          }
        },
        {
          "type": "config",
          "description": "Logging: SSR and NGINX now use Elastic Common Schema (ECS) JSON logs",
          "searchRegex": "LOGLEVEL|LOGFORMAT|LOG_ALL|LOGGING",
          "files": "nginx.conf,src/ssr/**/*.ts,docker-compose.yml",
          "severity": "medium",
          "manual": true,
          "breaking": true,
          "changes": [
            "Containers write logs exclusively to stdout",
            "Logging configured via LOGLEVEL and LOGFORMAT env vars only",
            "LOGGING (SSR) and LOG_ALL (SSR, NGINX) environment variables removed",
            "PM2 data included as JSON fields instead of prefixes",
            "Default format: structured JSON (ECS-compliant)"
          ],
          "example": {
            "before": "LOGGING=true, LOG_ALL=true",
            "after": "LOGLEVEL=info, LOGFORMAT=json"
          }
        },
        {
          "type": "typescript",
          "description": "Angular 17: New SSR architecture (@angular/ssr replaces @nguniversal)",
          "searchRegex": "@nguniversal|express-engine",
          "files": "**/*.ts,server.ts,main.server.ts",
          "severity": "high",
          "manual": true,
          "migration": "Angular upgrade handles most changes, verify custom SSR code",
          "example": {
            "before": "import { ngExpressEngine } from '@nguniversal/express-engine';",
            "after": "import { CommonEngine } from '@angular/ssr';"
          }
        },
        {
          "type": "typescript",
          "description": "NavigationCategory: New hideInMenu property for filtering categories",
          "searchRegex": "NavigationCategory|navigationCategories\\$\\(\\)|header-navigation\\.component",
          "files": "**/*.{ts,spec.ts,html}",
          "severity": "medium",
          "manual": true,
          "breaking": true,
          "modelChange": {
            "model": "NavigationCategory",
            "newProperty": "hideInMenu: boolean",
            "defaultValue": false,
            "description": "Categories with hideInMenu: true are filtered out from navigation display"
          },
          "componentImpact": [
            "HeaderNavigationComponent now filters categories based on hideInMenu",
            "Test data must include hideInMenu property",
            "Snapshot tests will show different rendered output (filtered categories)",
            "Custom themed templates (.b2c.html, .b2b.html) may need filtering logic if customized"
          ],
          "migration": "If you want all categories visible (old behavior), either: 1) Ensure backend never sets hideInMenu: true, or 2) Override component to remove filtering logic",
          "testMigration": "Update test data to include hideInMenu property. Tests that expect all categories to show should set hideInMenu: false",
          "example": {
            "before": "// Test data (PWA 9.x)\nconst categories = [\n  { uniqueId: 'A', name: 'CAT_A', url: '/cat/A' },\n  { uniqueId: 'B', name: 'CAT_B', url: '/cat/B' }\n];\n// All categories shown in navigation",
            "after": "// Test data (PWA 10.0+)\nconst categories = [\n  { uniqueId: 'A', name: 'CAT_A', url: '/cat/A', hideInMenu: false },\n  { uniqueId: 'B', name: 'CAT_B', url: '/cat/B', hideInMenu: true }\n] as NavigationCategory[];\n// Only category A shown; B is filtered out",
            "customization": "// To restore old behavior (show all)\nthis.categories$ = this.shoppingFacade.navigationCategories$();\n// Don't filter based on hideInMenu"
          }
        },
        {
          "type": "config",
          "description": "Node.js: Upgrade to Node 22.22.0 LTS with npm 10.9.4",
          "searchRegex": "NODE_VERSION|node.*version|engines.*node",
          "files": ".nvmrc,Dockerfile,package.json,.gitlab-ci.yml,.github/workflows/*",
          "severity": "low",
          "manual": true,
          "note": "Update all Node.js version references in Docker, CI/CD, and development configs",
          "example": {
            "before": "NODE_VERSION=18.16.0\nnpm: '~9.5.1'",
            "after": "NODE_VERSION=22.22.0\nnpm: '~10.9.4'"
          }
        },
        {
          "type": "config",
          "description": "NGINX: Cache clearing enabled by default (opt-in → opt-out)",
          "searchRegex": "CACHE_CLEARER",
          "files": "nginx.conf,docker-compose.yml,deployment/**/*",
          "severity": "low",
          "manual": true,
          "breaking": true,
          "note": "Set CACHE_CLEARER=off to disable if not wanted",
          "example": {
            "before": "# CACHE_CLEARER not set (disabled)",
            "after": "# CACHE_CLEARER=on by default, set to 'off' to disable"
          }
        },
        {
          "type": "typescript",
          "description": "Testing: RouterTestingModule deprecated, use provideRouter()",
          "searchRegex": "RouterTestingModule",
          "files": "**/*.spec.ts",
          "severity": "medium",
          "autoFixable": true,
          "note": "Angular 17 migration, applies to all test files",
          "example": {
            "before": "imports: [RouterTestingModule]",
            "after": "providers: [provideRouter(routes)]"
          }
        },
        {
          "type": "typescript",
          "description": "NgRx: Move concatLatestFrom import to @ngrx/operators",
          "searchRegex": "concatLatestFrom.*@ngrx/effects",
          "files": "**/*.effects.ts",
          "severity": "low",
          "autoFixable": true,
          "example": {
            "before": "import { concatLatestFrom } from '@ngrx/effects';",
            "after": "import { concatLatestFrom } from '@ngrx/operators';"
          }
        }
      ],
      "dependencyChanges": [
        {"package": "@angular/core", "from": "~16.x", "to": "~17.x", "breaking": true, "note": "Major Angular upgrade"},
        {"package": "bootstrap-icons", "action": "added", "version": "~1.11.x", "note": "Replaces Font Awesome"},
        {"package": "@fortawesome/angular-fontawesome", "action": "removed", "note": "Replaced by bootstrap-icons"},
        {"package": "@nguniversal/express-engine", "action": "removed", "note": "Replaced by @angular/ssr"},
        {"package": "@angular/ssr", "action": "added", "note": "New Angular 17 SSR architecture"},
        {"package": "node", "from": "18.x", "to": "22.x", "breaking": true, "note": "LTS upgrade"},
        {"package": "npm", "from": "~9.5.x", "to": "~10.9.x", "breaking": false, "note": "Package manager upgrade"}
      ],
      "testingChanges": [
        {
          "type": "refactor",
          "change": "RouterTestingModule deprecated",
          "action": "Use provideRouter() in test providers",
          "severity": "low"
        },
        {
          "type": "refactor",
          "change": "Empty element tags",
          "action": "Remove closing tags for self-closing elements in templates",
          "severity": "low"
        }
      ],
      "migrationNotes": [
        "Run ng generate @angular/core:control-flow for automated control flow migration",
        "Use scripts/migrate-bootstrap-icons.js for icon detection and migration",
        "Run scripts/validate-theme-completeness.js before first build to catch SCSS issues",
        "Review SSR custom code for @nguniversal references",
        "Update all Node.js references in infrastructure (Docker, CI/CD)",
        "Test inventory display as it now uses separate REST calls",
        "Review logging configuration for ECS format compatibility"
      ],
      "officialDocs": {
        "migrationGuide": "https://github.com/intershop/intershop-pwa/blob/develop/docs/guides/migrations.md#from-910-to-1000",
        "angularUpdateGuide": "https://angular.dev/update-guide?v=16.0-17.0&l=3",
        "bootstrapIcons": "https://icons.getbootstrap.com/"
      }
    },
    {
      "fromVersion": "14.0",
      "toVersion": "15.0",
      "description": "Angular 14 → 15 Migration",
      "patterns": [
        {
          "type": "typescript",
          "description": "Angular: Standalone Components introduction",
          "searchRegex": "@NgModule\\s*\\(",
          "files": "**/*.module.ts",
          "severity": "medium",
          "manual": true,
          "note": "Angular 15 introduces standalone components. Consider migrating modules to standalone."
        },
        {
          "type": "typescript",
          "description": "Angular: RouterTestingModule deprecated",
          "searchRegex": "RouterTestingModule",
          "files": "**/*.spec.ts",
          "severity": "low",
          "autoFixable": true,
          "example": {
            "before": "imports: [RouterTestingModule]",
            "after": "providers: [provideRouter([])]"
          }
        }
      ]
    },
    {
      "fromVersion": "15.0",
      "toVersion": "16.0",
      "description": "Angular 15 → 16 Migration",
      "patterns": [
        {
          "type": "typescript",
          "description": "Angular: Required inputs enforcement",
          "searchRegex": "@Input\\(\\)\\s+(?!.*!)[a-zA-Z]",
          "files": "**/*.component.ts",
          "severity": "medium",
          "manual": true,
          "note": "Angular 16 enforces required inputs. Add '!' for optional or use { required: true }"
        },
        {
          "type": "typescript",
          "description": "RxJS: toPromise() deprecated, use firstValueFrom/lastValueFrom",
          "searchRegex": "\\.toPromise\\(\\)",
          "files": "**/*.ts",
          "severity": "medium",
          "example": {
            "before": "const result = await observable.toPromise();",
            "after": "const result = await firstValueFrom(observable);"
          }
        }
      ]
    },
    {
      "fromVersion": "16.0",
      "toVersion": "17.0",
      "description": "Angular 16 → 17 Migration",
      "patterns": [
        {
          "type": "typescript",
          "description": "Angular: Control flow syntax (@if, @for, @switch)",
          "searchRegex": "\\*ngIf=",
          "files": "**/*.html",
          "severity": "low",
          "manual": true,
          "note": "Angular 17 introduces new control flow syntax. Consider migrating from *ngIf to @if"
        },
        {
          "type": "typescript",
          "description": "Angular: Standalone APIs become default",
          "searchRegex": "bootstrapModule",
          "files": "**/main.ts",
          "severity": "medium",
          "manual": true,
          "note": "Angular 17 prefers bootstrapApplication over bootstrapModule"
        }
      ]
    },
    {
      "fromVersion": "4.0",
      "toVersion": "9.1",
      "description": "PWA 4.x → 9.1 Major Version Jump",
      "patterns": [
        {
          "type": "typescript",
          "description": "Extensions: Check for removed extensions",
          "searchRegex": "tacton|removed-extension-name",
          "files": "src/app/extensions/**/*",
          "severity": "high",
          "manual": true,
          "note": "Some extensions may have been removed. Check src/app/extensions/ against target PWA"
        },
        {
          "type": "scss",
          "description": "Themes: New theme variables required",
          "searchRegex": "\\$CORPORATE-PRIMARY",
          "files": "src/styles/themes/**/*.scss",
          "severity": "high",
          "manual": true,
