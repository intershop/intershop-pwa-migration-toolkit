{
  "version": "1.1.0",
  "lastUpdated": "2026-03-23",
  "description": "Comprehensive pattern migration database for Intershop PWA versions",
  "migrations": [
    {
      "fromVersion": "8.0",
      "toVersion": "9.0",
      "description": "PWA 8.x → 9.0 Breaking Changes",
      "patterns": [
        {
          "type": "scss",
          "description": "SCSS: Sass module system - darken() deprecated",
          "oldPattern": "darken\\s*\\(",
          "newPattern": "color.adjust($color, $lightness: -X%)",
          "searchRegex": "darken\\s*\\(",
          "files": "**/*.scss",
          "severity": "high",
          "requiresImport": "@use 'sass:color';",
          "example": {
            "before": "$dark-color: darken($primary, 20%);",
            "after": "$dark-color: color.adjust($primary, $lightness: -20%);"
          }
        },
        {
          "type": "scss",
          "description": "SCSS: Sass module system - lighten() deprecated",
          "oldPattern": "lighten\\s*\\(",
          "newPattern": "color.adjust($color, $lightness: X%)",
          "searchRegex": "lighten\\s*\\(",
          "files": "**/*.scss",
          "severity": "high",
          "requiresImport": "@use 'sass:color';",
          "example": {
            "before": "$light-color: lighten($primary, 20%);",
            "after": "$light-color: color.adjust($primary, $lightness: 20%);"
          }
        },
        {
          "type": "scss",
          "description": "SCSS: Sass module system - map-get() deprecated",
          "oldPattern": "map-get\\s*\\(",
          "newPattern": "map.get(",
          "searchRegex": "map-get\\s*\\(",
          "files": "**/*.scss",
          "severity": "medium",
          "requiresImport": "@use 'sass:map';",
          "example": {
            "before": "$value: map-get($theme-colors, 'primary');",
            "after": "$value: map.get($theme-colors, 'primary');"
          }
        },
        {
          "type": "scss",
          "description": "SCSS: Sass module system - map-merge() deprecated",
          "oldPattern": "map-merge\\s*\\(",
          "newPattern": "map.merge(",
          "searchRegex": "map-merge\\s*\\(",
          "files": "**/*.scss",
          "severity": "medium",
          "requiresImport": "@use 'sass:map';",
          "example": {
            "before": "$merged: map-merge($defaults, $custom);",
            "after": "$merged: map.merge($defaults, $custom);"
          }
        },
        {
          "type": "scss",
          "description": "SCSS: Sass module system - str-length() deprecated",
          "oldPattern": "str-length\\s*\\(",
          "newPattern": "string.length(",
          "searchRegex": "str-length\\s*\\(",
          "files": "**/*.scss",
          "severity": "low",
          "requiresImport": "@use 'sass:string';",
          "example": {
            "before": "$len: str-length($text);",
            "after": "$len: string.length($text);"
          }
        }
      ]
    },
    {
      "fromVersion": "9.0",
      "toVersion": "9.1",
      "description": "PWA 9.0 → 9.1 Breaking Changes",
      "patterns": [
        {
          "type": "typescript",
          "description": "TypeScript: Stricter environment.model.ts typing",
          "searchRegex": "export\\s+const\\s+environment\\s*=",
          "files": "**/environment.model.ts",
          "severity": "medium",
          "manual": true,
          "example": {
            "before": "export const environment = { features: ['customFeature'] };",
            "after": "export const environment: Environment = { features: ['customFeature' as const] };"
          }
        },
        {
          "type": "html",
          "description": "Angular Templates: Empty paired tags should use self-closing syntax",
          "searchRegex": "<(ish-[a-z-]+|ng-container|ng-template)([^>]*)></\\1>",
          "files": "**/*.html",
          "severity": "low",
          "autoFixable": true,
          "example": {
            "before": "<ish-loading></ish-loading>",
            "after": "<ish-loading />"
          }
        }
      ]
    },
    {
      "fromVersion": "9.1",
      "toVersion": "10.0",
      "description": "PWA 9.1 → 10.0 Major Release - Angular 17, Bootstrap Icons",
      "angularVersion": "17",
      "nodeVersion": "22",
      "icmVersion": "14.0.1",
      "patterns": [
        {
          "type": "html",
          "description": "Angular 17: Control flow - *ngIf to @if migration",
          "searchRegex": "\\*ngIf\\s*=",
          "files": "**/*.html",
          "severity": "critical",
          "autoFixable": false,
          "manual": true,
          "note": "Angular 17 uses new control flow syntax. PWA 10.0 has migrated all templates to @if/@for/@switch syntax.",
          "example": {
            "before": "<div *ngIf=\"show\">Content</div>",
            "after": "@if (show) { <div>Content</div> }"
          }
        },
        {
          "type": "html",
          "description": "Angular 17: Control flow - *ngFor to @for migration",
          "searchRegex": "\\*ngFor\\s*=",
          "files": "**/*.html",
          "severity": "critical",
          "autoFixable": false,
          "manual": true,
          "note": "Angular 17 uses new control flow syntax. PWA 10.0 has migrated all templates to @for syntax.",
          "example": {
            "before": "<div *ngFor=\"let item of items\">{{item}}</div>",
            "after": "@for (item of items; track item) { <div>{{item}}</div> }"
          }
        },
        {
          "type": "html",
          "description": "Angular 17: Control flow - *ngSwitch to @switch migration",
          "searchRegex": "\\*ngSwitch\\s*=",
          "files": "**/*.html",
          "severity": "critical",
          "autoFixable": false,
          "manual": true,
          "note": "Angular 17 uses new control flow syntax. PWA 10.0 has migrated all templates to @switch syntax.",
          "example": {
            "before": "<div [ngSwitch]=\"value\">\n  <span *ngSwitchCase=\"'a'\">A</span>\n</div>",
            "after": "@switch (value) {\n  @case ('a') { <span>A</span> }\n}"
          }
        },
        {
          "type": "scss",
          "description": "Icons: Font Awesome replaced with Bootstrap Icons",
          "searchRegex": "(fa-|fas\\s|far\\s|fab\\s|font-awesome)",
          "files": "**/*.{scss,html,ts}",
          "severity": "high",
          "manual": true,
          "note": "PWA 10.0 replaces Font Awesome with Bootstrap Icons. Search for 'fa-' icon classes and replace with Bootstrap Icons equivalents.",
          "example": {
            "before": "<i class=\"fas fa-search\"></i>",
            "after": "<i class=\"bi bi-search\"></i>"
          }
        },
        {
          "type": "typescript",
          "description": "Inventory: Separate /inventories REST call",
          "searchRegex": "product.*inventory|getProduct.*includeInventory",
          "files": "**/*.{ts,service.ts}",
          "severity": "medium",
          "manual": true,
          "note": "Inventory information now fetched via separate /inventories REST call instead of with products.",
          "example": {
            "before": "getProduct(sku, includeInventory: true)",
            "after": "getProduct(sku) + separate inventoryService.getInventory(sku)"
          }
        },
        {
          "type": "config",
          "description": "Logging: NGINX/SSR logging configuration changed",
          "searchRegex": "logger|log.*format|LOG_FORMAT",
          "files": "nginx.conf,src/ssr/server.ts,docker/**/*",
          "severity": "medium",
          "manual": true,
          "note": "Logging configuration and default format changed to ECS-compatible format. Review nginx.conf and SSR logging setup.",
          "example": {
            "before": "Custom log format",
            "after": "ECS-compatible JSON logging"
          }
        },
        {
          "type": "typescript",
          "description": "Angular 17: New SSR architecture",
          "searchRegex": "express-engine|@nguniversal",
          "files": "**/*.ts,server.ts",
          "severity": "high",
          "manual": true,
          "note": "Angular 17 introduces new SSR architecture. Check for @nguniversal references that may need updating.",
          "example": {
            "before": "@nguniversal/express-engine",
            "after": "@angular/ssr"
          }
        },
        {
          "type": "config",
          "description": "Node.js: Upgrade to Node 22 LTS",
          "searchRegex": "node.*version|NODE_VERSION",
          "files": ".nvmrc,Dockerfile,package.json,.gitlab-ci.yml",
          "severity": "low",
          "manual": true,
          "note": "PWA 10.0 is developed and tested with Node.js 22.x LTS. Update .nvmrc, Dockerfiles, and CI/CD configs.",
          "example": {
            "before": "NODE_VERSION=18",
            "after": "NODE_VERSION=22"
          }
        },
        {
          "type": "scss",
          "description": "Themes: Bootstrap variables cleanup",
          "searchRegex": "\\$theme-color|\\$bootstrap-",
          "files": "src/styles/themes/**/*.scss",
          "severity": "medium",
          "manual": true,
          "note": "PWA 10.0 includes Bootstrap variables cleanup. Review custom theme variables for changes.",
          "example": {
            "before": "$theme-color-custom: ...",
            "after": "See b2b/b2c theme for updated variable structure"
          }
        }
      ]
    },
    {
      "fromVersion": "14.0",
      "toVersion": "15.0",
      "description": "Angular 14 → 15 Migration",
      "patterns": [
        {
          "type": "typescript",
          "description": "Angular: Standalone Components introduction",
          "searchRegex": "@NgModule\\s*\\(",
          "files": "**/*.module.ts",
          "severity": "medium",
          "manual": true,
          "note": "Angular 15 introduces standalone components. Consider migrating modules to standalone."
        },
        {
          "type": "typescript",
          "description": "Angular: RouterTestingModule deprecated",
          "searchRegex": "RouterTestingModule",
          "files": "**/*.spec.ts",
          "severity": "low",
          "autoFixable": true,
          "example": {
            "before": "imports: [RouterTestingModule]",
            "after": "providers: [provideRouter([])]"
          }
        }
      ]
    },
    {
      "fromVersion": "15.0",
      "toVersion": "16.0",
      "description": "Angular 15 → 16 Migration",
      "patterns": [
        {
          "type": "typescript",
          "description": "Angular: Required inputs enforcement",
          "searchRegex": "@Input\\(\\)\\s+(?!.*!)[a-zA-Z]",
          "files": "**/*.component.ts",
          "severity": "medium",
          "manual": true,
          "note": "Angular 16 enforces required inputs. Add '!' for optional or use { required: true }"
        },
        {
          "type": "typescript",
          "description": "RxJS: toPromise() deprecated, use firstValueFrom/lastValueFrom",
          "searchRegex": "\\.toPromise\\(\\)",
          "files": "**/*.ts",
          "severity": "medium",
          "example": {
            "before": "const result = await observable.toPromise();",
            "after": "const result = await firstValueFrom(observable);"
          }
        }
      ]
    },
    {
      "fromVersion": "16.0",
      "toVersion": "17.0",
      "description": "Angular 16 → 17 Migration",
      "patterns": [
        {
          "type": "typescript",
          "description": "Angular: Control flow syntax (@if, @for, @switch)",
          "searchRegex": "\\*ngIf=",
          "files": "**/*.html",
          "severity": "low",
          "manual": true,
          "note": "Angular 17 introduces new control flow syntax. Consider migrating from *ngIf to @if"
        },
        {
          "type": "typescript",
          "description": "Angular: Standalone APIs become default",
          "searchRegex": "bootstrapModule",
          "files": "**/main.ts",
          "severity": "medium",
          "manual": true,
          "note": "Angular 17 prefers bootstrapApplication over bootstrapModule"
        }
      ]
    },
    {
      "fromVersion": "4.0",
      "toVersion": "9.1",
      "description": "PWA 4.x → 9.1 Major Version Jump",
      "patterns": [
        {
          "type": "typescript",
          "description": "Extensions: Check for removed extensions",
          "searchRegex": "tacton|removed-extension-name",
          "files": "src/app/extensions/**/*",
          "severity": "high",
          "manual": true,
          "note": "Some extensions may have been removed. Check src/app/extensions/ against target PWA"
        },
        {
          "type": "scss",
          "description": "Themes: New theme variables required",
          "searchRegex": "\\$CORPORATE-PRIMARY",
          "files": "src/styles/themes/**/*.scss",
          "severity": "high",
          "manual": true,
          "note": "Custom themes need new variables. Compare with b2b theme in target version"
        },
        {
          "type": "typescript",
          "description": "Environment: Features registration changed",
          "searchRegex": "export\\s+const\\s+features",
          "files": "**/environment.ts",
          "severity": "high",
          "manual": true,
          "note": "Feature registration requires updates in both environment.model.ts and configuration"
        }
      ]
    }
  ],
  "commonPatterns": {
    "scss": [
      {
        "name": "Missing theme variables",
        "detection": "Build fails with 'Undefined variable' in SCSS",
        "solution": "Compare custom theme with b2b/b2c theme, add missing variables",
        "tier": 1
      },
      {
        "name": "Deprecated Sass functions",
        "detection": "Deprecation warnings during SCSS compilation",
        "solution": "Use Sass module system (@use 'sass:color', etc.)",
        "tier": 2
      }
    ],
    "typescript": [
      {
        "name": "Environment feature registration",
        "detection": "Custom features not loaded at runtime",
        "solution": "Register in both environment.model.ts and environment configuration",
        "tier": 1
      },
      {
        "name": "Module import conflicts",
        "detection": "Build fails with 'X is not exported from module'",
        "solution": "Merge imports from both branches in module files",
        "tier": 1
      }
    ],
    "templates": [
      {
        "name": "B2B template variants",
        "detection": "B2B features broken after migration",
        "solution": "Check for both .html and .b2b.html template files",
        "tier": 1
      },
      {
        "name": "Removed component selectors",
        "detection": "Build fails with 'Unknown element'",
        "solution": "Check if component was removed or renamed in target PWA",
        "tier": 2
      }
    ]
  },
  "detectionTiers": {
    "tier1": {
      "name": "Manual CHANGELOG Review",
      "description": "Human/AI reviews CHANGELOG.md manually",
      "suitableFor": "Light customization, 1-2 versions behind",
      "tools": ["Git remote setup", "Manual diff checking"]
    },
    "tier2": {
      "name": "Automated Pattern Detection",
      "description": "Script fetches CHANGELOG and scans codebase",
      "suitableFor": "Moderate customization, 2-4 versions behind",
      "tools": ["detect-pattern-changes.js", "grep-based scanning"]
    },
    "tier3": {
      "name": "Comprehensive Pattern Database",
      "description": "Full pattern library with transformation rules",
      "suitableFor": "Heavy customization, 5+ versions behind",
      "tools": ["detect-pattern-changes.js --comprehensive", "pattern-migrations.json"]
    }
  }
}
