{
  "folders": [
    {
      "name": "Custom PWA",
      "path": "../pwa/developer-pwa"
    },
    {
      "name": "Migration Toolkit",
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true
    },
    "terminal.integrated.env.linux": {
      "PWA_PROJECT_DIR": "${workspaceFolder:Custom PWA}"
    },
    "terminal.integrated.env.osx": {
      "PWA_PROJECT_DIR": "${workspaceFolder:Custom PWA}"
    },
    "terminal.integrated.env.windows": {
      "PWA_PROJECT_DIR": "${workspaceFolder:Custom PWA}"
    }
  },
  "mcpServers": {
    "kb-in-azure": {
      "url": "https://<YOUR_KB_ENDPOINT>/api/v1/mcp",
      "type": "http"
    }
  }
}
